<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="14.3.0">
  <zoom_level>10</zoom_level>

  <!-- ============================================================ -->
  <!-- Title                                                          -->
  <!-- ============================================================ -->
  <element>
    <id>UMLNote</id>
    <coordinates><x>350</x><y>5</y><w>820</w><h>40</h></coordinates>
    <panel_attributes>*/Diagram czynności – Proces obsługi odpadów (WasteLog)/*
bg=white
fontsize=18
halign=center
valign=center</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- ============================================================ -->
  <!-- Swimlane headers (colored)                                     -->
  <!-- ============================================================ -->
  <element>
    <id>UMLNote</id>
    <coordinates><x>10</x><y>55</y><w>380</w><h>40</h></coordinates>
    <panel_attributes>*Punkt sprzedaży*
bg=#dde6f5
fontsize=14
halign=center
valign=center</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLNote</id>
    <coordinates><x>390</x><y>55</y><w>600</w><h>40</h></coordinates>
    <panel_attributes>*Magazyn*
bg=#dceedd
fontsize=14
halign=center
valign=center</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLNote</id>
    <coordinates><x>990</x><y>55</y><w>320</w><h>40</h></coordinates>
    <panel_attributes>*Firma utylizacyjna*
bg=#fdf3d1
fontsize=14
halign=center
valign=center</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLNote</id>
    <coordinates><x>1310</x><y>55</y><w>220</w><h>40</h></coordinates>
    <panel_attributes>*Administracja*
bg=#e9dcef
fontsize=14
halign=center
valign=center</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- ============================================================ -->
  <!-- Lane vertical dividers                                         -->
  <!-- ============================================================ -->
  <element>
    <id>Relation</id>
    <coordinates><x>388</x><y>95</y><w>10</w><h>945</h></coordinates>
    <panel_attributes>lt=-</panel_attributes>
    <additional_attributes>5;5;5;940</additional_attributes>
  </element>
  <element>
    <id>Relation</id>
    <coordinates><x>988</x><y>95</y><w>10</w><h>945</h></coordinates>
    <panel_attributes>lt=-</panel_attributes>
    <additional_attributes>5;5;5;940</additional_attributes>
  </element>
  <element>
    <id>Relation</id>
    <coordinates><x>1308</x><y>95</y><w>10</w><h>945</h></coordinates>
    <panel_attributes>lt=-</panel_attributes>
    <additional_attributes>5;5;5;940</additional_attributes>
  </element>

  <!-- ============================================================ -->
  <!-- PUNKT SPRZEDAŻY lane                                           -->
  <!-- ============================================================ -->

  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>185</x><y>110</y><w>30</w><h>30</h></coordinates>
    <panel_attributes>type=initial</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLState</id>
    <coordinates><x>110</x><y>180</y><w>180</w><h>70</h></coordinates>
    <panel_attributes>Zgłoszenie
niesprzedanego pieczywa</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLState</id>
    <coordinates><x>110</x><y>290</y><w>180</w><h>60</h></coordinates>
    <panel_attributes>Wprowadzenie
ilości odpadów</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLState</id>
    <coordinates><x>110</x><y>380</y><w>180</w><h>70</h></coordinates>
    <panel_attributes>Wybór kategorii
odpadu</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- ============================================================ -->
  <!-- MAGAZYN lane                                                   -->
  <!-- ============================================================ -->

  <element>
    <id>UMLState</id>
    <coordinates><x>460</x><y>200</y><w>200</w><h>50</h></coordinates>
    <panel_attributes>Weryfikacja zgłoszenia</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- Decision: Czy dane są poprawne? -->
  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>500</x><y>275</y><w>120</w><h>80</h></coordinates>
    <panel_attributes>type=decision
Czy dane są
poprawne?</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLState</id>
    <coordinates><x>700</x><y>290</y><w>170</w><h>60</h></coordinates>
    <panel_attributes>Odrzucenie
zgłoszenia</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLState</id>
    <coordinates><x>700</x><y>380</y><w>170</w><h>60</h></coordinates>
    <panel_attributes>Wyświetlenie
komunikatu błędu</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- final after Wyświetlenie komunikatu błędu -->
  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>770</x><y>470</y><w>30</w><h>30</h></coordinates>
    <panel_attributes>type=final</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLState</id>
    <coordinates><x>460</x><y>420</y><w>200</w><h>50</h></coordinates>
    <panel_attributes>Zatwierdzenie
zgłoszenia</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- Decision: Czy produkt nadaje się do przeceny? -->
  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>495</x><y>500</y><w>130</w><h>90</h></coordinates>
    <panel_attributes>type=decision
Czy produkt
nadaje się do
przeceny?</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLState</id>
    <coordinates><x>400</x><y>670</y><w>170</w><h>80</h></coordinates>
    <panel_attributes>Przekazanie do
sprzedaży
promocyjnej</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLState</id>
    <coordinates><x>590</x><y>670</y><w>180</w><h>80</h></coordinates>
    <panel_attributes>Przygotowanie
produktów do utylizacji</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLState</id>
    <coordinates><x>400</x><y>790</y><w>170</w><h>60</h></coordinates>
    <panel_attributes>Aktualizacja stanu
magazynowego</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- final after Aktualizacja stanu magazynowego -->
  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>470</x><y>880</y><w>30</w><h>30</h></coordinates>
    <panel_attributes>type=final</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- ============================================================ -->
  <!-- FIRMA UTYLIZACYJNA lane                                        -->
  <!-- ============================================================ -->

  <element>
    <id>UMLState</id>
    <coordinates><x>1060</x><y>705</y><w>180</w><h>50</h></coordinates>
    <panel_attributes>Odbiór odpadów</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLState</id>
    <coordinates><x>1060</x><y>800</y><w>180</w><h>60</h></coordinates>
    <panel_attributes>Potwierdzenie
utylizacji</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- ============================================================ -->
  <!-- ADMINISTRACJA lane                                             -->
  <!-- ============================================================ -->

  <element>
    <id>UMLState</id>
    <coordinates><x>1330</x><y>800</y><w>200</w><h>60</h></coordinates>
    <panel_attributes>Archiwizacja raportu
(WasteLog)</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>1420</x><y>890</y><w>30</w><h>30</h></coordinates>
    <panel_attributes>type=final</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- ============================================================ -->
  <!-- Transitions                                                    -->
  <!-- ============================================================ -->

  <!-- T1: start -> Zgłoszenie -->
  <element>
    <id>Relation</id>
    <coordinates><x>195</x><y>135</y><w>20</w><h>50</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;5;5;45</additional_attributes>
  </element>

  <!-- T2: Zgłoszenie -> Wprowadzenie -->
  <element>
    <id>Relation</id>
    <coordinates><x>195</x><y>245</y><w>20</w><h>50</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;5;5;45</additional_attributes>
  </element>

  <!-- T3: Wprowadzenie -> Wybór kategorii -->
  <element>
    <id>Relation</id>
    <coordinates><x>195</x><y>345</y><w>20</w><h>40</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;5;5;35</additional_attributes>
  </element>

  <!-- T4: Wybór kategorii -> Weryfikacja zgłoszenia (cross-lane, L-shape up-right) -->
  <element>
    <id>Relation</id>
    <coordinates><x>285</x><y>220</y><w>185</w><h>200</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;195;90;195;90;5;175;5</additional_attributes>
  </element>

  <!-- T5: Weryfikacja -> decision dane -->
  <element>
    <id>Relation</id>
    <coordinates><x>555</x><y>245</y><w>20</w><h>40</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;5;5;35</additional_attributes>
  </element>

  <!-- T6: decision NIE -> Odrzucenie -->
  <element>
    <id>Relation</id>
    <coordinates><x>615</x><y>305</y><w>95</w><h>30</h></coordinates>
    <panel_attributes>lt=-&gt;
NIE</panel_attributes>
    <additional_attributes>5;15;85;15</additional_attributes>
  </element>

  <!-- T7: Odrzucenie -> Wyświetlenie komunikatu -->
  <element>
    <id>Relation</id>
    <coordinates><x>775</x><y>345</y><w>20</w><h>45</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;5;5;35</additional_attributes>
  </element>

  <!-- T8: Wyświetlenie komunikatu -> final -->
  <element>
    <id>Relation</id>
    <coordinates><x>775</x><y>435</y><w>20</w><h>45</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;5;5;35</additional_attributes>
  </element>

  <!-- T9: decision TAK -> Zatwierdzenie -->
  <element>
    <id>Relation</id>
    <coordinates><x>555</x><y>350</y><w>30</w><h>80</h></coordinates>
    <panel_attributes>lt=-&gt;
TAK</panel_attributes>
    <additional_attributes>5;5;5;70</additional_attributes>
  </element>

  <!-- T10: Zatwierdzenie -> decision produkt -->
  <element>
    <id>Relation</id>
    <coordinates><x>555</x><y>465</y><w>20</w><h>45</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;5;5;35</additional_attributes>
  </element>

  <!-- T11: decision produkt TAK -> Przekazanie -->
  <element>
    <id>Relation</id>
    <coordinates><x>460</x><y>580</y><w>90</w><h>100</h></coordinates>
    <panel_attributes>lt=-&gt;
TAK</panel_attributes>
    <additional_attributes>75;5;25;90</additional_attributes>
  </element>

  <!-- T12: decision produkt NIE -> Przygotowanie -->
  <element>
    <id>Relation</id>
    <coordinates><x>590</x><y>580</y><w>110</w><h>100</h></coordinates>
    <panel_attributes>lt=-&gt;
NIE</panel_attributes>
    <additional_attributes>20;5;90;90</additional_attributes>
  </element>

  <!-- T13: Przekazanie -> Aktualizacja -->
  <element>
    <id>Relation</id>
    <coordinates><x>475</x><y>745</y><w>20</w><h>50</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;5;5;45</additional_attributes>
  </element>

  <!-- T14: Aktualizacja -> final -->
  <element>
    <id>Relation</id>
    <coordinates><x>478</x><y>845</y><w>20</w><h>40</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;5;5;35</additional_attributes>
  </element>

  <!-- T15: Przygotowanie -> Odbiór odpadów (cross-lane) -->
  <element>
    <id>Relation</id>
    <coordinates><x>765</x><y>705</y><w>305</w><h>30</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;15;295;15</additional_attributes>
  </element>

  <!-- T16: Odbiór odpadów -> Potwierdzenie utylizacji -->
  <element>
    <id>Relation</id>
    <coordinates><x>1140</x><y>750</y><w>20</w><h>55</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;5;5;45</additional_attributes>
  </element>

  <!-- T17: Potwierdzenie utylizacji -> Archiwizacja (cross-lane) -->
  <element>
    <id>Relation</id>
    <coordinates><x>1235</x><y>820</y><w>105</w><h>20</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;10;95;10</additional_attributes>
  </element>

  <!-- T18: Archiwizacja -> final -->
  <element>
    <id>Relation</id>
    <coordinates><x>1425</x><y>855</y><w>20</w><h>45</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;5;5;35</additional_attributes>
  </element>

</diagram>
