<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="14.3.0">
  <zoom_level>10</zoom_level>

  <!-- Title -->
  <element>
    <id>UMLNote</id>
    <coordinates><x>200</x><y>5</y><w>920</w><h>40</h></coordinates>
    <panel_attributes>*/Diagram czynnosci - Generowanie raportu miesięcznego/*
bg=white
fontsize=18
halign=center
valign=center</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- Swimlane headers -->
  <element>
    <id>UMLNote</id>
    <coordinates><x>10</x><y>55</y><w>488</w><h>40</h></coordinates>
    <panel_attributes>*Dyspozytor*
bg=#dde6f5
fontsize=14
halign=center
valign=center</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLNote</id>
    <coordinates><x>500</x><y>55</y><w>488</w><h>40</h></coordinates>
    <panel_attributes>*Kierownik piekarni*
bg=#dceedd
fontsize=14
halign=center
valign=center</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLNote</id>
    <coordinates><x>990</x><y>55</y><w>300</w><h>40</h></coordinates>
    <panel_attributes>*Administracja*
bg=#e9dcef
fontsize=14
halign=center
valign=center</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- Lane dividers -->
  <element>
    <id>Relation</id>
    <coordinates><x>498</x><y>95</y><w>10</w><h>1125</h></coordinates>
    <panel_attributes>lt=-</panel_attributes>
    <additional_attributes>5;5;5;1120</additional_attributes>
  </element>
  <element>
    <id>Relation</id>
    <coordinates><x>988</x><y>95</y><w>10</w><h>1125</h></coordinates>
    <panel_attributes>lt=-</panel_attributes>
    <additional_attributes>5;5;5;1120</additional_attributes>
  </element>

  <!-- ==================== DYSPOZYTOR LANE ==================== -->

  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>234</x><y>100</y><w>30</w><h>30</h></coordinates>
    <panel_attributes>type=initial</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLState</id>
    <coordinates><x>144</x><y>160</y><w>210</w><h>60</h></coordinates>
    <panel_attributes>Inicjowanie generowania
raportu miesiecznego</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLState</id>
    <coordinates><x>154</x><y>260</y><w>190</w><h>50</h></coordinates>
    <panel_attributes>Wybor zakresu
i okresu raportu</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLState</id>
    <coordinates><x>134</x><y>350</y><w>230</w><h>75</h></coordinates>
    <panel_attributes>Zbieranie danych
(zamowienia, dostawy,
odpady, trasy)</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>174</x><y>458</y><w>150</w><h>80</h></coordinates>
    <panel_attributes>type=decision
Czy dane
kompletne?</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLState</id>
    <coordinates><x>144</x><y>598</y><w>210</w><h>60</h></coordinates>
    <panel_attributes>Generowanie
raportu</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLState</id>
    <coordinates><x>154</x><y>700</y><w>190</w><h>50</h></coordinates>
    <panel_attributes>Przeglad
wygenerowanego raportu</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLState</id>
    <coordinates><x>144</x><y>880</y><w>210</w><h>60</h></coordinates>
    <panel_attributes>Korekta
raportu</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- ==================== KIEROWNIK PIEKARNI LANE ==================== -->

  <element>
    <id>UMLState</id>
    <coordinates><x>634</x><y>468</y><w>220</w><h>60</h></coordinates>
    <panel_attributes>Uzupelnienie
brakujacych danych</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLState</id>
    <coordinates><x>629</x><y>660</y><w>230</w><h>60</h></coordinates>
    <panel_attributes>Weryfikacja raportu
przez kierownika</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLState</id>
    <coordinates><x>634</x><y>768</y><w>220</w><h>60</h></coordinates>
    <panel_attributes>Analiza wskaznikow
sprzedazy i odpadow</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>659</x><y>868</y><w>170</w><h>80</h></coordinates>
    <panel_attributes>type=decision
Czy raport
zatwierdzony?</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- ==================== ADMINISTRACJA LANE ==================== -->

  <element>
    <id>UMLState</id>
    <coordinates><x>1035</x><y>878</y><w>200</w><h>60</h></coordinates>
    <panel_attributes>Archiwizacja
raportu</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLState</id>
    <coordinates><x>1035</x><y>978</y><w>200</w><h>60</h></coordinates>
    <panel_attributes>Powiadomienie
punktow sprzedazy</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLState</id>
    <coordinates><x>1035</x><y>1075</y><w>200</w><h>55</h></coordinates>
    <panel_attributes>Wysylka podsumowania
do zarzadu</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <id>UMLSpecialState</id>
    <coordinates><x>1120</x><y>1160</y><w>30</w><h>30</h></coordinates>
    <panel_attributes>type=final</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- ==================== TRANSITIONS ==================== -->

  <!-- initial -> D1 -->
  <element>
    <id>Relation</id>
    <coordinates><x>244</x><y>125</y><w>20</w><h>40</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;5;5;35</additional_attributes>
  </element>

  <!-- D1 -> D_wybor -->
  <element>
    <id>Relation</id>
    <coordinates><x>244</x><y>215</y><w>20</w><h>50</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;5;5;45</additional_attributes>
  </element>

  <!-- D_wybor -> D2 -->
  <element>
    <id>Relation</id>
    <coordinates><x>244</x><y>305</y><w>20</w><h>50</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;5;5;45</additional_attributes>
  </element>

  <!-- D2 -> D_dec1 -->
  <element>
    <id>Relation</id>
    <coordinates><x>244</x><y>420</y><w>20</w><h>43</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;5;5;38</additional_attributes>
  </element>

  <!-- D_dec1 NIE -> K1 (horizontal right) -->
  <!-- D_dec1 right: (324, 498), K1 left: (634, 498) -->
  <element>
    <id>Relation</id>
    <coordinates><x>319</x><y>493</y><w>320</w><h>20</h></coordinates>
    <panel_attributes>lt=-&gt;
NIE</panel_attributes>
    <additional_attributes>5;10;315;10</additional_attributes>
  </element>

  <!-- K1 back to D2 (up then left) -->
  <!-- K1 top center: (744, 468), D2 right: (364, 387) -->
  <element>
    <id>Relation</id>
    <coordinates><x>359</x><y>382</y><w>390</w><h>91</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>385;86;385;5;5;5</additional_attributes>
  </element>

  <!-- D_dec1 TAK -> D3 (down) -->
  <!-- D_dec1 bottom: (249, 538), D3 top: (249, 598) -->
  <element>
    <id>Relation</id>
    <coordinates><x>244</x><y>533</y><w>20</w><h>70</h></coordinates>
    <panel_attributes>lt=-&gt;
TAK</panel_attributes>
    <additional_attributes>5;5;5;65</additional_attributes>
  </element>

  <!-- D3 -> D_przeglad (down) -->
  <element>
    <id>Relation</id>
    <coordinates><x>244</x><y>653</y><w>20</w><h>52</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;5;5;47</additional_attributes>
  </element>

  <!-- D_przeglad -> K2 (cross-lane right) -->
  <!-- D_przeglad right: (344, 725), K2 left: (629, 690) -->
  <element>
    <id>Relation</id>
    <coordinates><x>339</x><y>685</y><w>295</w><h>45</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;40;290;40;290;5</additional_attributes>
  </element>

  <!-- K2 -> K_analiza -->
  <element>
    <id>Relation</id>
    <coordinates><x>739</x><y>715</y><w>20</w><h>58</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;5;5;53</additional_attributes>
  </element>

  <!-- K_analiza -> K_dec -->
  <element>
    <id>Relation</id>
    <coordinates><x>739</x><y>823</y><w>20</w><h>50</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;5;5;45</additional_attributes>
  </element>

  <!-- K_dec NIE -> D4 (cross-lane left) -->
  <!-- K_dec left: (659, 908), D4 right: (354, 910) -->
  <element>
    <id>Relation</id>
    <coordinates><x>349</x><y>903</y><w>315</w><h>20</h></coordinates>
    <panel_attributes>lt=-&gt;
NIE</panel_attributes>
    <additional_attributes>310;10;5;10</additional_attributes>
  </element>

  <!-- D4 loop back to D3 (left side loop up) -->
  <!-- D4 left: (144, 910), D3 left: (144, 628) -->
  <element>
    <id>Relation</id>
    <coordinates><x>85</x><y>623</y><w>65</w><h>292</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>59;287;5;287;5;5;59;5</additional_attributes>
  </element>

  <!-- K_dec TAK -> A1 (cross-lane right, down) -->
  <!-- K_dec right: (829, 908), A1 left: (1035, 908) -->
  <element>
    <id>Relation</id>
    <coordinates><x>824</x><y>903</y><w>216</w><h>20</h></coordinates>
    <panel_attributes>lt=-&gt;
TAK</panel_attributes>
    <additional_attributes>5;10;211;10</additional_attributes>
  </element>

  <!-- A1 -> A2 -->
  <element>
    <id>Relation</id>
    <coordinates><x>1130</x><y>933</y><w>20</w><h>50</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;5;5;45</additional_attributes>
  </element>

  <!-- A2 -> A3 -->
  <element>
    <id>Relation</id>
    <coordinates><x>1130</x><y>1033</y><w>20</w><h>47</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;5;5;42</additional_attributes>
  </element>

  <!-- A3 -> A_final -->
  <element>
    <id>Relation</id>
    <coordinates><x>1130</x><y>1125</y><w>20</w><h>40</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>5;5;5;35</additional_attributes>
  </element>

</diagram>
